# ═══════════════════════════════════════════════════════════
#  CloudHunting - Environment Variables Template
#  Copy file nay thanh .env va dien gia tri that
# ═══════════════════════════════════════════════════════════

# ── Bao mat ──────────────────────────────────────────────
# Chuoi bi mat de ky JWT token (PHAI DOI TRUOC KHI DEPLOY!)
JWT_SECRET=thay-bang-chuoi-bi-mat-that-dai-va-ngau-nhien

# Tat che do dev token (bat buoc khi deploy)
MOCK_AUTH=false

# ── URL noi bo cac services ──────────────────────────────
# Mac dinh la localhost, chi can doi khi dung Docker Compose
# S1_URL=http://127.0.0.1:8001
# S2_URL=http://127.0.0.1:8002
# S3_URL=http://127.0.0.1:8003
# S5_URL=http://127.0.0.1:8005
# S6_URL=http://127.0.0.1:8006

# ── Gateway ──────────────────────────────────────────────
# GATEWAY_HOST=0.0.0.0
# GATEWAY_PORT=8000

# ── Database ─────────────────────────────────────────────
# Mac dinh la SQLite, doi khi can chuyen sang PostgreSQL
# DATABASE_URL=sqlite:///./app.db
